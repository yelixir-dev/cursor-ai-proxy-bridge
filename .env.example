# Cursor AI Bridge runtime configuration
# Copy to .env and edit before exposing the bridge beyond a trusted network.

CURSOR_BRIDGE_HOST=127.0.0.1
CURSOR_BRIDGE_PORT=9997

# on | off. Defaults to on when CURSOR_BRIDGE_API_KEY is set, otherwise off.
# Auth-off mode is suitable only for localhost or a trusted private network.
CURSOR_BRIDGE_AUTH=on
# Required when CURSOR_BRIDGE_AUTH=on; ignored for client auth when it is off.
CURSOR_BRIDGE_API_KEY=replace-with-a-long-random-client-key

# auto (default) probes the headless cursor-api first, then falls back to an
# executable Cursor CLI. Set cursor-api or cursor-cli to force one path.
CURSOR_BRIDGE_BACKEND=auto
# CURSOR_BRIDGE_BACKEND=cursor-api
# CURSOR_BRIDGE_BACKEND=cursor-cli
CURSOR_BRIDGE_DEFAULT_MODEL=composer-2.5

# Safe default: do not mount a real workspace.
CURSOR_BRIDGE_WORKSPACE_MODE=chat-only
# CURSOR_BRIDGE_WORKSPACE_MODE=real-workspace
# CURSOR_BRIDGE_REAL_WORKSPACE=/absolute/path/to/project

# Cursor CLI backend settings. Some headless installs expose the binary as agent,
# for example: /home/ubuntu/.local/bin/agent
# CURSOR_BRIDGE_CURSOR_BIN=cursor
# CURSOR_BRIDGE_CURSOR_BIN=/home/ubuntu/.local/bin/agent
# Hard ceiling for one upstream Run. Keep this above the idle watchdog so
# active reasoning and multi-tool rounds can finish while dead Runs fail fast.
CURSOR_BRIDGE_CURSOR_TIMEOUT_MS=300000
CURSOR_BRIDGE_RUN_IDLE_MS=30000
CURSOR_BRIDGE_TERMINATION_GRACE_MS=750
CURSOR_BRIDGE_MAX_OUTPUT_BYTES=8388608

# Headless cursor-api authentication. Prefer a direct access token or API key;
# on macOS the backend otherwise reads cursor-access-token from Keychain.
# CURSOR_AUTH_TOKEN=
# CURSOR_API_KEY=
# Additional cursor-api credentials and model overrides are stored in the
# mode-0600 dashboard config. CURSOR_API_KEY remains an independent env credential.
# CURSOR_BRIDGE_DASHBOARD_CONFIG=~/.config/cursor-ai-proxy-bridge/dashboard.json
# CURSOR_BRIDGE_CREDENTIAL_COOLDOWN_MS=300000
# Legacy API override (CURSOR_BRIDGE_CURSOR_API_ENDPOINT takes precedence):
# CURSOR_API_ENDPOINT=https://api2.cursor.sh
# CURSOR_BRIDGE_CURSOR_API_ENDPOINT=https://api2.cursor.sh
# CURSOR_BRIDGE_CURSOR_AGENT_ENDPOINT=https://agentn.global.api5.cursor.sh
# Descriptor snapshot override for hosts WITHOUT cursor-agent: run
# `npm run extract-protos` once where the CLI is installed, copy the file over,
# and point this at it:
# CURSOR_BRIDGE_CURSOR_API_DESCRIPTORS=/absolute/path/to/proto-descriptors.json
# CURSOR_BRIDGE_CURSOR_BIN=/absolute/path/to/cursor-agent
# CURSOR_BRIDGE_AUTO_PROBE_TIMEOUT_MS=5000
# CURSOR_BRIDGE_AUTO_COOLDOWN_MS=60000
# CURSOR_BRIDGE_AUTO_FATAL_THRESHOLD=3
# CURSOR_BRIDGE_CURSOR_RETRY_BASE_MS=1000

# In-flight completion limits. Real-workspace requests sharing a directory are serialized.
CURSOR_BRIDGE_MAX_CONCURRENCY=16
CURSOR_BRIDGE_MAX_CONCURRENCY_PER_KEY=16

# Children receive only a minimal runtime/Cursor environment by default. Add exact
# variable names here only when the Cursor installation requires them.
# CURSOR_BRIDGE_CHILD_ENV_ALLOW=HTTPS_PROXY,HTTP_PROXY
